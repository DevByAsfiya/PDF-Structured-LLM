# ==============================================================================
# JAL Catalogue Intelligence Pipeline Environment Configuration
# ==============================================================================
# Hard Rule: No secrets in code. Stages 00-06 are deterministic and make ZERO network calls.
# Stages 07+ use LLMs for normalization, taxonomy, and search assistance.

# --- Extraction & Geometry Thresholds ---
PDFSCRAPER_CONFIDENCE_THRESHOLD=0.85
PDFSCRAPER_MIN_IMAGE_AREA_PX=5000
PDFSCRAPER_MAX_IMAGE_AREA_RATIO=0.85
PDFSCRAPER_BATCH_SIZE=10
PDFSCRAPER_LOG_LEVEL=INFO

# --- Enrichment & Embedding Model Registry ---
PDFSCRAPER_NORMALIZER_MODEL=gemini-2.0-flash
PDFSCRAPER_ENRICHMENT_LLM_MODEL=llama-3.3-70b-versatile
PDFSCRAPER_TEXT_EMBED_MODEL=text-embedding-3-small
PDFSCRAPER_IMAGE_EMBED_MODEL=clip-ViT-B-32
PDFSCRAPER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- API Keys (Enrichment Stages 07+) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
